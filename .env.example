# Supabase (Dashboard → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# New publishable key (preferred) — or use legacy anon JWT below
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Legacy (still supported by this app if publishable key is unset)
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Practice bot LLM (server-only) — /api/chat/ai-reply
# Priority: ops-managed Cerebras/Groq key pool → Gemini → OpenAI → local stubs.
# On 429, the next key in the pool is tried immediately in the same request.
#
# Env fallbacks (also support comma-separated lists):
CEREBRAS_API_KEY=
# CEREBRAS_API_KEYS=key1,key2
# CEREBRAS_CHAT_MODEL=gpt-oss-120b
# CEREBRAS_INPUT_PRICE_PER_1M=0.60
# CEREBRAS_OUTPUT_PRICE_PER_1M=0.60

GROQ_API_KEY=
# GROQ_API_KEYS=key1,key2
# GROQ_CHAT_MODEL=llama-3.1-8b-instant
# GROQ_INPUT_PRICE_PER_1M=0.05
# GROQ_OUTPUT_PRICE_PER_1M=0.08

# Optional secret used to encrypt ops-managed API keys at rest (defaults to cookie secret / ops password)
# OPS_API_KEYS_SECRET=

# LLM cost / abuse guards (server-only, optional)
# LLM_DAILY_BUDGET_USD=2.00
# LLM_MAX_CALLS_PER_ROOM=12
# LLM_SOFT_CALLS_PER_USER_HOUR=100
# LLM_SOFT_CALLS_PER_USER_DAY=250
# LLM_AUTO_BLOCK_COST_USD_DAY=5.00
# LLM_SPIKE_CALLS_PER_10_MIN=120

# Ops alert emails on LLM usage spikes / auto-blocks (Resend)
# RESEND_API_KEY=
# OPS_ALERT_FROM=BanterBird Alerts <onboarding@resend.dev>

GOOGLE_API_KEY=
# GEMINI_API_KEY=   # alias for GOOGLE_API_KEY

# Optional Gemini model (default gemini-2.5-flash)
# GEMINI_CHAT_MODEL=gemini-2.5-flash

# Optional token pricing for analytics cost estimates (USD per 1M tokens)
# GEMINI_INPUT_PRICE_PER_1M=0.15
# GEMINI_OUTPUT_PRICE_PER_1M=0.60
# OPENAI_INPUT_PRICE_PER_1M=0.15
# OPENAI_OUTPUT_PRICE_PER_1M=0.60

# OpenAI fallback (used when Cerebras/Groq pool and Gemini are unavailable)
OPENAI_API_KEY=
# OPENAI_CHAT_MODEL=gpt-4o-mini

# Optional: full system prompt for the practice bot (replaces lib/ai-practice-bot/instructions.ts persona text).
# JSON output rules are still appended automatically so replies stay parseable (reply vs skip).
# Leave unset to use the editable instructions file in the repo.
# PRACTICE_BOT_SYSTEM_PROMPT=
# OPENAI_PRACTICE_BOT_SYSTEM_PROMPT=   # legacy alias

# Internal analytics (/ops/banterbird-stats): password-gated dashboard (server-only secrets).
# SUPABASE_SERVICE_ROLE_KEY: Dashboard → Settings → API → service_role (never expose to client).
# OPS_ANALYTICS_PASSWORD: gate for the analytics UI.
# OPS_ANALYTICS_COOKIE_SECRET: optional; defaults to OPS_ANALYTICS_PASSWORD for signing the session cookie.
SUPABASE_SERVICE_ROLE_KEY=
OPS_ANALYTICS_PASSWORD=
OPS_ANALYTICS_COOKIE_SECRET=

# Public site URL (must be banterbird.app — not .com)
# NEXT_PUBLIC_APP_URL=https://banterbird.app
# GOOGLE_SITE_VERIFICATION=
