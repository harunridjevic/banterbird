# Supabase (Dashboard → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# New publishable key (preferred) — or use legacy anon JWT below
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Legacy (still supported by this app if publishable key is unset)
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# OpenAI (server-only): powers short, human-like practice bot replies in /api/chat/ai-reply
# If unset, the bot uses simple built-in fallback lines.
OPENAI_API_KEY=

# Optional override (default gpt-4o-mini)
# OPENAI_CHAT_MODEL=gpt-4o-mini
