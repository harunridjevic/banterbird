# Supabase (Dashboard → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# New publishable key (preferred) — or use legacy anon JWT below
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Legacy (still supported by this app if publishable key is unset)
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Practice bot LLM (server-only) — /api/chat/ai-reply
# Google Gemini is used when GOOGLE_API_KEY or GEMINI_API_KEY is set (preferred).
# Otherwise OpenAI is used when OPENAI_API_KEY is set.
# If neither is set, the bot uses simple built-in fallback lines.
GOOGLE_API_KEY=AIzaSyDWu8ihEhMgBF9LSlANNJRoYa_WY6R4wJ4
# GEMINI_API_KEY=   # alias for GOOGLE_API_KEY

# Optional Gemini model (default gemini-2.5-flash)
# GEMINI_CHAT_MODEL=gemini-2.5-flash

# OpenAI fallback (only used when no Google key is set)
OPENAI_API_KEY=
# OPENAI_CHAT_MODEL=gpt-4o-mini

# Optional: full system prompt for the practice bot (replaces lib/ai-practice-bot/instructions.ts persona text).
# JSON output rules are still appended automatically so replies stay parseable (reply vs skip).
# Leave unset to use the editable instructions file in the repo.
# PRACTICE_BOT_SYSTEM_PROMPT=
# OPENAI_PRACTICE_BOT_SYSTEM_PROMPT=   # legacy alias

# Internal analytics (/ops/banterbird-stats): password-gated dashboard (server-only secrets).
# SUPABASE_SERVICE_ROLE_KEY: Dashboard → Settings → API → service_role (never expose to client).
# OPS_ANALYTICS_PASSWORD: gate for the analytics UI.
# OPS_ANALYTICS_COOKIE_SECRET: optional; defaults to OPS_ANALYTICS_PASSWORD for signing the session cookie.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_7Gswi0S3WzLVbQma9aYkIA_HY9bO7wa
OPS_ANALYTICS_PASSWORD=bbbbanterbird
OPS_ANALYTICS_COOKIE_SECRET=v0Y0Yf7m0v4xjL8r8G5vL0n0j4M6x2u7Q8n1fW2bK5sR9aT6cH3pL1==
