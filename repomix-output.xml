<file path="app/api/ops/analytics/data/route.ts">
import { NextResponse } from "next/server";
import { cookies } from "next/headers";
import { COOKIE_NAME, cookieSecret, verifyAnalyticsCookie } from "@/lib/ops/analytics-cookie";
import { analyticsPasswordConfigured } from "@/lib/ops/analytics-password";
import {
  type AnalyticsPeriod,
  resolvePeriodDays,
} from "@/lib/ops/analytics-types";
import { createServiceRoleClient } from "@/lib/supabase/service-role";

export async function GET(req: Request) {
  if (!analyticsPasswordConfigured()) {
    return NextResponse.json({ error: "Analytics is not configured on the server." }, { status: 503 });
  }

  const secret = cookieSecret();
  if (!secret) {
    return NextResponse.json({ error: "Server misconfiguration" }, { status: 503 });
  }

  const cookieStore = await cookies();
  const token = cookieStore.get(COOKIE_NAME)?.value;
  if (!verifyAnalyticsCookie(secret, token)) {
    return NextResponse.json({ error: "Unauthorized" }, { status: 401 });
  }

  const { searchParams } = new URL(req.url);
  const period = (searchParams.get("period") ?? "month") as AnalyticsPeriod;
  const rawDays = searchParams.get("days");
  const customDays = rawDays ? Number.parseInt(rawDays, 10) || 30 : 30;
  const days = resolvePeriodDays(
    ["today", "week", "month", "year", "custom"].includes(period) ? period : "month",
    customDays,
  );

  try {
    const admin = createServiceRoleClient();
    const { data, error } = await admin.rpc("ops_analytics_snapshot", { p_days: days });
    if (error) {
      console.error("ops_analytics_snapshot", error);
      return NextResponse.json({ error: error.message }, { status: 500 });
    }
    return NextResponse.json({ snapshot: data });
  } catch (e) {
    const msg = e instanceof Error ? e.message : "Server error";
    if (msg.includes("SUPABASE_SERVICE_ROLE_KEY")) {
      return NextResponse.json({ error: "Service role key missing (SUPABASE_SERVICE_ROLE_KEY)." }, { status: 503 });
    }
    console.error(e);
    return NextResponse.json({ error: msg }, { status: 500 });
  }
}
</file>

<file path="app/api/ops/analytics/unlock/route.ts">
import { NextResponse } from "next/server";
import { cookies } from "next/headers";
import {
  COOKIE_NAME,
  cookieSecret,
  signAnalyticsCookie,
} from "@/lib/ops/analytics-cookie";
import { analyticsPasswordConfigured, verifyAnalyticsPassword } from "@/lib/ops/analytics-password";

export async function POST(req: Request) {
  if (!analyticsPasswordConfigured()) {
    return NextResponse.json({ error: "Analytics is not configured on the server." }, { status: 503 });
  }

  let body: unknown;
  try {
    body = await req.json();
  } catch {
    return NextResponse.json({ error: "Invalid JSON" }, { status: 400 });
  }
  const password = typeof body === "object" && body !== null && "password" in body ? (body as { password?: unknown }).password : undefined;
  if (typeof password !== "string" || password.length === 0) {
    return NextResponse.json({ error: "Password required" }, { status: 400 });
  }

  if (!verifyAnalyticsPassword(password)) {
    return NextResponse.json({ error: "Unauthorized" }, { status: 401 });
  }

  const secret = cookieSecret();
  if (!secret) {
    return NextResponse.json({ error: "Server misconfiguration" }, { status: 503 });
  }

  const token = signAnalyticsCookie(secret);
  const cookieStore = await cookies();
  cookieStore.set(COOKIE_NAME, token, {
    httpOnly: true,
    secure: process.env.NODE_ENV === "production",
    sameSite: "strict",
    path: "/",
    maxAge: 12 * 60 * 60,
  });

  return NextResponse.json({ ok: true });
}
