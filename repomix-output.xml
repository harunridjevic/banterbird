-- Gender-aware matchmaking preferences and room metadata.

alter table public.match_queue
  add column if not exists self_gender text,
  add column if not exists wants_gender text;

update public.match_queue
set
  self_gender = coalesce(self_gender, 'male'),
  wants_gender = coalesce(wants_gender, 'any')
where
  self_gender is null
  or wants_gender is null;

alter table public.match_queue
  alter column self_gender set default 'male',
  alter column wants_gender set default 'any',
  alter column self_gender set not null,
  alter column wants_gender set not null;

do $$
begin
  if not exists (
    select 1
    from pg_constraint
    where conname = 'match_queue_self_gender_check'
      and conrelid = 'public.match_queue'::regclass
  ) then
    alter table public.match_queue
      add constraint match_queue_self_gender_check check (self_gender in ('male', 'female'));
  end if;
end
$$;

do $$
begin
  if not exists (
    select 1
    from pg_constraint
    where conname = 'match_queue_wants_gender_check'
      and conrelid = 'public.match_queue'::regclass
  ) then
    alter table public.match_queue
      add constraint match_queue_wants_gender_check check (wants_gender in ('male', 'female', 'any'));
  end if;
end
$$;

alter table public.rooms
  add column if not exists user_a_gender text,
  add column if not exists user_b_gender text;

do $$
begin
  if not exists (
    select 1
    from pg_constraint
    where conname = 'rooms_user_a_gender_check'
      and conrelid = 'public.rooms'::regclass
  ) then
    alter table public.rooms
      add constraint rooms_user_a_gender_check check (user_a_gender is null or user_a_gender in ('male', 'female'));
  end if;
end
$$;

do $$
begin
  if not exists (
    select 1
    from pg_constraint
    where conname = 'rooms_user_b_gender_check'
      and conrelid = 'public.rooms'::regclass
  ) then
    alter table public.rooms
      add constraint rooms_user_b_gender_check check (user_b_gender is null or user_b_gender in ('male', 'female'));
  end if;
end
$$;

drop function if exists public.try_match();

create or replace function public.try_match(p_self_gender text default 'male', p_wants_gender text default 'any')
returns uuid
language plpgsql
security definer
set search_path = public
as $$
declare
  me uuid := auth.uid();
  partner_id uuid;
  partner_gender text;
  new_room_id uuid;
  existing_id uuid;
  existing_peer_gender text;
  existing_self_gender text;
  my_gender text := lower(trim(p_self_gender));
  wanted_gender text := lower(trim(p_wants_gender));
begin
  if me is null then
    raise exception 'Not authenticated';
  end if;

  if my_gender not in ('male', 'female') then
    raise exception 'Invalid self gender';
  end if;

  if wanted_gender not in ('male', 'female', 'any') then
    raise exception 'Invalid wanted gender';
  end if;

  select
    r.id,
    case when r.user_a = me then r.user_b_gender else r.user_a_gender end,
    case when r.user_a = me then r.user_a_gender else r.user_b_gender end
  into existing_id, existing_peer_gender, existing_self_gender
  from public.rooms r
  where
    (r.user_a = me or r.user_b = me)
    and r.ended_at is null
  order by r.created_at desc
  limit 1;

  if existing_id is not null then
    if
      existing_self_gender = my_gender
      and (wanted_gender = 'any' or existing_peer_gender = wanted_gender)
    then
      return existing_id;
    end if;

    -- Preferences changed since this room was created: close it and rematch.
    update public.rooms
    set ended_at = now()
    where id = existing_id and ended_at is null;
  end if;

  delete from public.match_queue where user_id = me;

  select mq.user_id, mq.self_gender
  into partner_id, partner_gender
  from public.match_queue mq
  where
    mq.user_id <> me
    and (wanted_gender = 'any' or mq.self_gender = wanted_gender)
    and (mq.wants_gender = 'any' or mq.wants_gender = my_gender)
  order by mq.joined_at asc
  limit 1
  for update
  skip locked;

  if partner_id is not null then
    delete from public.match_queue where user_id = partner_id;

    insert into public.rooms (user_a, user_b, user_a_gender, user_b_gender)
    values (
      case when me::text < partner_id::text then me else partner_id end,
      case when me::text < partner_id::text then partner_id else me end,
      case when me::text < partner_id::text then my_gender else partner_gender end,
      case when me::text < partner_id::text then partner_gender else my_gender end
    )
    returning id into new_room_id;

    return new_room_id;
  end if;

  insert into public.match_queue (user_id, self_gender, wants_gender)
  values (me, my_gender, wanted_gender)
  on conflict (user_id) do update
    set
      joined_at = now(),
      self_gender = excluded.self_gender,
      wants_gender = excluded.wants_gender;

  return null;
end;
$$;

grant execute on function public.try_match(text, text) to authenticated;
</file>

<file path="supabase/migrations/20260513120000_ai_practice_chat.sql">
-- AI practice rooms: optional bot match when no human is available.
-- Human is always user_a; user_b is null for AI sessions.

alter table public.rooms
  add column if not exists is_ai_room boolean not null default false,
  add column if not exists bot_gender text;

do $$
begin
  if not exists (
    select 1
    from pg_constraint
    where conname = 'rooms_bot_gender_check'
      and conrelid = 'public.rooms'::regclass
  ) then
    alter table public.rooms
      add constraint rooms_bot_gender_check check (
        bot_gender is null
        or bot_gender in ('male', 'female')
      );
  end if;
end
$$;

alter table public.rooms
  alter column user_b drop not null;

alter table public.rooms
  drop constraint if exists rooms_different_users;

do $$
begin
  if not exists (
    select 1
    from pg_constraint
    where conname = 'rooms_participants_check'
      and conrelid = 'public.rooms'::regclass
  ) then
    alter table public.rooms
      add constraint rooms_participants_check check (
        (is_ai_room = true and user_b is null)
        or (
          coalesce(is_ai_room, false) = false
          and user_b is not null
          and user_a <> user_b
        )
      );
  end if;
end
$$;

alter table public.messages
  add column if not exists is_from_ai boolean not null default false;

alter table public.messages
  alter column user_id drop not null;

do $$
begin
  if not exists (
    select 1
    from pg_constraint
    where conname = 'messages_sender_ai_check'
      and conrelid = 'public.messages'::regclass
  ) then
    alter table public.messages
      add constraint messages_sender_ai_check check (
        (is_from_ai = true and user_id is null)
        or (coalesce(is_from_ai, false) = false and user_id is not null)
      );
  end if;
end
$$;

drop policy if exists "messages_select_if_room_member" on public.messages;

create policy "messages_select_if_room_member"
  on public.messages
  for select
  using (
    exists (
      select 1
      from public.rooms r
      where
        r.id = messages.room_id
        and (
          r.user_a = auth.uid()
          or r.user_b = auth.uid()
        )
    )
  );

drop policy if exists "messages_insert_if_room_member" on public.messages;

create policy "messages_insert_if_room_member"
  on public.messages
  for insert
  with check (
    coalesce(is_from_ai, false) = false
    and auth.uid() = user_id
    and exists (
      select 1
      from public.rooms r
      where
        r.id = room_id
        and r.ended_at is null
        and (
          r.user_a = auth.uid()
          or r.user_b = auth.uid()
        )
    )
  );

create or replace function public.insert_ai_chat_message(p_room_id uuid, p_content text)
returns void
language plpgsql
security definer
set search_path = public
as $$
declare
  trimmed text := trim(p_content);
  inserted_count int;
begin
  if auth.uid() is null then
    raise exception 'Not authenticated';
  end if;

  if trimmed is null or char_length(trimmed) = 0 then
    raise exception 'Empty message';
  end if;

  if char_length(trimmed) > 2000 then
    raise exception 'Message too long';
  end if;

  if not exists (
    select 1
    from public.rooms r
    where
      r.id = p_room_id
      and r.is_ai_room = true
      and r.ended_at is null
      and r.user_a = auth.uid()
  ) then
    raise exception 'Not allowed';
  end if;

  insert into public.messages (room_id, user_id, content, is_from_ai)
  values (p_room_id, null, trimmed, true);

  get diagnostics inserted_count = row_count;
  if inserted_count <> 1 then
    raise exception 'Insert failed';
  end if;
end;
$$;

grant execute on function public.insert_ai_chat_message(uuid, text) to authenticated;

create or replace function public.try_match_ai_practice(p_self_gender text, p_wants_gender text)
returns uuid
language plpgsql
security definer
set search_path = public
as $$
declare
  me uuid := auth.uid();
  rid uuid;
  my_gender text := lower(trim(p_self_gender));
  wanted_gender text := lower(trim(p_wants_gender));
  bot_g text;
begin
  if me is null then
    raise exception 'Not authenticated';
  end if;

  if my_gender not in ('male', 'female') then
    raise exception 'Invalid self gender';
  end if;

  if wanted_gender not in ('male', 'female', 'any') then
    raise exception 'Invalid wanted gender';
  end if;

  select r.id
  into rid
  from public.rooms r
  where
    (r.user_a = me or r.user_b = me)
    and r.ended_at is null
  order by r.created_at desc
  limit 1;

  if rid is not null then
    return rid;
  end if;

  delete from public.match_queue
  where user_id = me;

  if wanted_gender = 'any' then
    bot_g := case when random() < 0.5 then 'male' else 'female' end;
  elsif wanted_gender = 'male' then
    bot_g := 'male';
  else
    bot_g := 'female';
  end if;

  insert into public.rooms (
    user_a,
    user_b,
    user_a_gender,
    user_b_gender,
    is_ai_room,
    bot_gender
  )
  values (me, null, my_gender, bot_g, true, bot_g)
  returning id into rid;

  return rid;
end;
$$;

grant execute on function public.try_match_ai_practice(text, text) to authenticated;
</file>

<file path="supabase/migrations/20260514100000_ops_analytics.sql">
-- Internal analytics snapshot (callable only with service role from server).
-- Computes DAU, D1 (signup cohort), room/chat metrics, AI fallback rate.

create or replace function public.ops_analytics_snapshot(p_days integer default 30)
returns jsonb
language plpgsql
volatile
security definer
set search_path = public, auth
as $$
declare
  v_days int := greatest(1, least(coalesce(p_days, 30), 365));
  v_since timestamptz := (timezone('utc', now()) - (v_days || ' days')::interval);
  v_today date := (timezone('utc', now()))::date;
  v_yesterday date := v_today - 1;
  v_dau_today bigint;
  v_dau_yesterday bigint;
  v_d1_signup numeric;
  v_avg_human_room_minutes numeric;
  v_skip_rate numeric;
  v_tt_first_human_median_sec numeric;
  v_avg_rooms_per_user numeric;
  v_convo_minutes_avg numeric;
  v_ai_fallback_rate numeric;
  v_total_rooms bigint;
  v_human_rooms bigint;
  v_ai_rooms bigint;
  v_human_ended bigint;
  v_skipped bigint;
  v_dau_series jsonb;
begin
  -- ---------- DAU (UTC): distinct users with room or human message activity that calendar day ----------
  with daily as (
    select distinct
      x.uid,
      x.d
    from (
      select user_a as uid, (created_at at time zone 'utc')::date as d
      from public.rooms
      where created_at >= v_since
      union all
      select user_b, (created_at at time zone 'utc')::date
      from public.rooms
      where user_b is not null
        and created_at >= v_since
      union all
      select user_id, (created_at at time zone 'utc')::date
      from public.messages
      where user_id is not null
        and created_at >= v_since
    ) x
  )
  select
    count(*) filter (where d = v_today),
    count(*) filter (where d = v_yesterday)
  into v_dau_today, v_dau_yesterday
  from daily;

  select coalesce(
    jsonb_agg(jsonb_build_object('date', d::text, 'dau', c) order by d),
    '[]'::jsonb
  )
  into v_dau_series
  from (
    select d, count(*)::bigint as c
    from (
      select distinct
        x.uid,
        x.d
      from (
        select user_a as uid, (created_at at time zone 'utc')::date as d
        from public.rooms
        where created_at >= v_since
        union all
        select user_b, (created_at at time zone 'utc')::date
        from public.rooms
        where user_b is not null
          and created_at >= v_since
        union all
        select user_id, (created_at at time zone 'utc')::date
        from public.messages
        where user_id is not null
          and created_at >= v_since
      ) x
    ) u
    group by d
  ) s;

  -- ---------- D1 retention (signup cohort): signed up day D, active any way on D+1 ----------
  with cohort as (
    select
      u.id,
      (u.created_at at time zone 'utc')::date as signup_d
    from auth.users u
    where u.created_at >= v_since
      and (u.created_at at time zone 'utc')::date <= v_today - 2
  ),
  next_day_active as (
    select c.id
    from cohort c
    where exists (
      select 1
      from (
        select user_id as uid, (created_at at time zone 'utc')::date as d
        from public.messages
        where user_id is not null
        union all
        select user_a, (created_at at time zone 'utc')::date
        from public.rooms
        union all
        select user_b, (created_at at time zone 'utc')::date
        from public.rooms
        where user_b is not null
      ) a
      where a.uid = c.id
        and a.d = c.signup_d + 1
    )
  )
  select
    case
      when (select count(*) from cohort) = 0 then null::numeric
      else round(
        (select count(*)::numeric from next_day_active)
        / nullif((select count(*)::numeric from cohort), 0),
        4
      )
    end
  into v_d1_signup;

  -- ---------- Room counts (created in window) ----------
  select
    count(*)::bigint,
    count(*) filter (where not coalesce(is_ai_room, false))::bigint,
    count(*) filter (where coalesce(is_ai_room, false))::bigint
  into v_total_rooms, v_human_rooms, v_ai_rooms
  from public.rooms
  where created_at >= v_since;

  v_ai_fallback_rate := case
    when coalesce(v_total_rooms, 0) = 0 then null::numeric
    else round(v_ai_rooms::numeric / v_total_rooms::numeric, 4)
  end;

  -- ---------- Avg human ended room lifetime (minutes) ----------
  select round(
    avg(extract(epoch from (ended_at - created_at)) / 60.0)::numeric,
    2
  )
  into v_avg_human_room_minutes
  from public.rooms r
  where r.created_at >= v_since
    and r.ended_at is not null
    and not coalesce(r.is_ai_room, false);

  -- ---------- Skip rate: ended human room, no human messages OR very short ----------
  with hm as (
    select room_id, count(*)::bigint as c
    from public.messages
    where user_id is not null
    group by room_id
  ),
  ended_human as (
    select r.id, r.created_at, r.ended_at, coalesce(hm.c, 0::bigint) as human_msgs
    from public.rooms r
    left join hm on hm.room_id = r.id
    where r.created_at >= v_since
      and r.ended_at is not null
      and not coalesce(r.is_ai_room, false)
  )
  select
    count(*)::bigint,
    count(*) filter (
      where human_msgs = 0
        or extract(epoch from (ended_at - created_at)) < 20
    )::bigint
  into v_human_ended, v_skipped
  from ended_human;

  v_skip_rate := case
    when coalesce(v_human_ended, 0) = 0 then null::numeric
    else round(v_skipped::numeric / v_human_ended::numeric, 4)
  end;

  -- ---------- Time to first human match (median seconds): signup -> first human room ----------
  with per_user_first as (
    select
      uid,
      min(first_at) as first_human_at
    from (
      select user_a as uid, min(created_at) as first_at
      from public.rooms
      where not coalesce(is_ai_room, false)
      group by user_a
      union all
      select user_b, min(created_at)
      from public.rooms
      where user_b is not null
        and not coalesce(is_ai_room, false)
      group by user_b
    ) z
    group by uid
  ),
  deltas as (
    select extract(epoch from (f.first_human_at - u.created_at))::numeric as sec
    from per_user_first f
    join auth.users u on u.id = f.uid
    where u.created_at >= v_since
      and f.first_human_at is not null
  )
  select round(percentile_cont(0.5) within group (order by sec)::numeric, 1)
  into v_tt_first_human_median_sec
  from deltas;

  -- ---------- Avg rooms per user (any room type) in window ----------
  with per_user as (
    select uid, count(distinct rid) as n
    from (
      select user_a as uid, id as rid
      from public.rooms
      where created_at >= v_since
      union all
      select user_b, id
      from public.rooms
      where user_b is not null
        and created_at >= v_since
    ) x
    group by uid
  )
  select round(avg(n)::numeric, 2)
  into v_avg_rooms_per_user
  from per_user;

  -- ---------- Avg conversation span (first human msg -> last msg) in human rooms, minutes ----------
  with bounds as (
    select
      m.room_id,
      min(m.created_at) as first_ts,
      max(m.created_at) as last_ts
    from public.messages m
    join public.rooms r on r.id = m.room_id
    where r.created_at >= v_since
      and not coalesce(r.is_ai_room, false)
    group by m.room_id
    having count(*) filter (where m.user_id is not null) > 0
  )
  select round(avg(extract(epoch from (last_ts - first_ts)) / 60.0)::numeric, 2)
  into v_convo_minutes_avg
  from bounds;

  return jsonb_build_object(
    'windowDays', v_days,
    'sinceUtc', v_since,
    'computedAtUtc', timezone('utc', now()),
    'dauTodayUtc', v_dau_today,
    'dauYesterdayUtc', v_dau_yesterday,
    'dauByDayUtc', coalesce(v_dau_series, '[]'::jsonb),
    'd1RetentionSignupCohort', v_d1_signup,
    'd1RetentionNote',
    'Share of users who signed up on or after since with signup date at least 2 UTC days ago, who had any activity on calendar day signup+1 (UTC).',
    'avgHumanEndedRoomMinutes', v_avg_human_room_minutes,
    'skipRateHumanEndedRooms', v_skip_rate,
    'skipRateNote',
    'Share of ended human-human rooms with no human messages or duration under 20s.',
    'timeToFirstHumanMatchMedianSeconds', v_tt_first_human_median_sec,
    'timeToFirstHumanMatchNote',
    'Among users who signed up in the window and have a human room: median seconds from auth.users.created_at to first human room created_at.',
    'avgRoomsPerUserInWindow', v_avg_rooms_per_user,
    'matchesPerSessionNote',
    'Average distinct rooms per user (user_a or user_b) with room created in the window.',
    'conversationDurationAvgMinutesHumanRooms', v_convo_minutes_avg,
    'conversationDurationNote',
    'Per human room (created in window): avg(last message - first message), all messages in room.',
