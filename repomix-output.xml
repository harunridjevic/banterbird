<file path="components/chat/bot-turn.ts">
import type { SupabaseClient } from "@supabase/supabase-js";
import {
  preTypingHesitation,
  readDelayBeforeReplyMs,
  readDelayOpenerMs,
  runHumanlikeTyping,
  typingDurationForReply,
  type TimingScale,
} from "./typing";

export type BotApiBody = {
  action?: string;
  reply?: string;
  messages?: string[];
  parting?: string | null;
  awayMs?: number;
  returnMessages?: string[];
  timing?: Partial<TimingScale> & {
    burstGapMs?: number;
    idlePingMs?: number;
    idleSkipMs?: number;
  };
};

function sleep(ms: number) {
  return new Promise<void>((resolve) => window.setTimeout(resolve, ms));
}

function linesFromBody(body: BotApiBody): string[] {
  if (Array.isArray(body.messages) && body.messages.length > 0) {
    return body.messages.map((m) => m.trim()).filter(Boolean);
  }
  const single = body.reply?.trim();
  return single ? [single] : [];
}

async function insertBotLine(
  client: SupabaseClient,
  roomId: string,
  content: string,
) {
  const { error } = await client.rpc("insert_ai_chat_message", {
    p_room_id: roomId,
    p_content: content,
  });
  return error;
}

async function deliverLines(
  lines: string[],
  scale: TimingScale,
  burstGapMs: number,
  setPeerTyping: (v: boolean) => void,
  client: SupabaseClient,
  roomId: string,
  onError: (msg: string) => void,
) {
  for (let i = 0; i < lines.length; i++) {
    const line = lines[i]!;
    await preTypingHesitation(scale);
    await runHumanlikeTyping(
      setPeerTyping,
      typingDurationForReply(line, scale),
      line.length,
    );
    const err = await insertBotLine(client, roomId, line);
    if (err) onError(err.message);
    if (i < lines.length - 1 && burstGapMs > 0) {
      await sleep(burstGapMs + Math.random() * 420);
    }
  }
}

export async function executeBotTurn(opts: {
  body: BotApiBody;
  client: SupabaseClient;
  roomId: string;
  setPeerTyping: (v: boolean) => void;
  onError: (msg: string) => void;
  userMessageLen?: number;
  isOpener?: boolean;
}): Promise<"skip" | "done"> {
  const { body, client, roomId, setPeerTyping, onError, userMessageLen = 0, isOpener } = opts;
  const scale: TimingScale = {
    readScale: body.timing?.readScale ?? 1,
    typingScale: body.timing?.typingScale ?? 1,
  };
  const burstGapMs = body.timing?.burstGapMs ?? 0;

  if (body.action === "skip") {
    const parting =
      typeof body.parting === "string" && body.parting.trim().length > 0
        ? body.parting.trim()
        : null;
    if (parting) {
      await deliverLines([parting], scale, 0, setPeerTyping, client, roomId, onError);
    } else {
      await sleep(500 + Math.random() * 1400);
      setPeerTyping(true);
      await sleep(650 + Math.random() * 1700);
      setPeerTyping(false);
    }
    return "skip";
  }

  if (body.action === "away") {
    const awayLines = linesFromBody(body);
    const returnLines =
      Array.isArray(body.returnMessages) && body.returnMessages.length > 0
        ? body.returnMessages.map((m) => m.trim()).filter(Boolean)
        : ["im back"];
    const awayMs = typeof body.awayMs === "number" ? body.awayMs : 45_000;

    if (awayLines.length > 0) {
      await deliverLines(awayLines, scale, burstGapMs, setPeerTyping, client, roomId, onError);
    }
    setPeerTyping(false);
    await sleep(awayMs);
    await deliverLines(returnLines, scale, burstGapMs, setPeerTyping, client, roomId, onError);
    return "done";
  }

  const lines = linesFromBody(body);
  if (lines.length === 0) return "done";

  if (!isOpener) {
    await sleep(readDelayBeforeReplyMs(userMessageLen, scale));
  } else {
    await sleep(readDelayOpenerMs(scale));
  }

  await deliverLines(lines, scale, burstGapMs, setPeerTyping, client, roomId, onError);
  return "done";
}

export type { TimingScale };
</file>

<file path="components/chat/ChatComposer.tsx">
"use client";

import { useCallback, useEffect, useRef, useState } from "react";
import { motion } from "framer-motion";
import { Send } from "lucide-react";

type Props = {
  disabled?: boolean;
  onSend: (text: string) => Promise<void>;
  onTypingChange: (typing: boolean) => void;
};

export function ChatComposer({ disabled, onSend, onTypingChange }: Props) {
  const [value, setValue] = useState("");
  const [sending, setSending] = useState(false);
  const typingTimer = useRef<ReturnType<typeof setTimeout> | null>(null);

  const clearTypingTimer = () => {
    if (typingTimer.current) {
      clearTimeout(typingTimer.current);
      typingTimer.current = null;
    }
  };

  const scheduleTypingStop = useCallback(() => {
    clearTypingTimer();
    typingTimer.current = setTimeout(() => {
      onTypingChange(false);
      typingTimer.current = null;
    }, 1200);
  }, [onTypingChange]);

  useEffect(() => {
    return () => {
      clearTypingTimer();
      onTypingChange(false);
    };
  }, [onTypingChange]);

  const handleChange = (next: string) => {
    setValue(next);
    if (next.trim()) {
      onTypingChange(true);
      scheduleTypingStop();
    } else {
      clearTypingTimer();
      onTypingChange(false);
    }
  };

  const submit = async () => {
    const t = value.trim();
    if (!t || sending || disabled) return;
    setSending(true);
    clearTypingTimer();
    onTypingChange(false);
    try {
      await onSend(t);
      setValue("");
    } finally {
      setSending(false);
    }
  };

  return (
    <div className="glass-panel rounded-3xl p-2 sm:p-3">
      <div className="flex items-end gap-2">
        <textarea
          rows={1}
          disabled={disabled || sending}
          placeholder="Say something nice…"
          className="max-h-32 min-h-[44px] flex-1 resize-none rounded-2xl border border-navy-200/80 bg-white/80 px-4 py-3 text-[15px] text-navy-950 outline-none ring-navy-900/10 placeholder:text-navy-400 focus:ring-2 dark:border-white/10 dark:bg-navy-950/60 dark:text-navy-50 dark:placeholder:text-navy-500"
          value={value}
          onChange={(e) => handleChange(e.target.value)}
          onKeyDown={(e) => {
            if (e.key === "Enter" && !e.shiftKey) {
              e.preventDefault();
              void submit();
            }
          }}
        />
        <motion.button
          type="button"
          whileHover={{ scale: 1.04 }}
          whileTap={{ scale: 0.96 }}
          disabled={!value.trim() || sending || disabled}
          onClick={() => void submit()}
          className="flex h-11 w-11 shrink-0 items-center justify-center rounded-2xl bg-navy-900 text-white shadow-md transition enabled:hover:bg-navy-800 disabled:cursor-not-allowed disabled:opacity-40 dark:bg-navy-100 dark:text-navy-950 dark:enabled:hover:bg-white"
          aria-label="Send message"
        >
          <Send className="h-5 w-5" />
        </motion.button>
      </div>
    </div>
  );
}
